# ==============================================================================
# Reward River Environment Configuration (.env.example)
# Copy this file to .env and configure with your production credentials.
# NEVER commit your real .env file or private keys to source control!
# ==============================================================================

# Application Environment & URLs
NODE_ENV=development
PORT=3000
APP_URL="http://localhost:3000"
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-string-for-sessions"

# ------------------------------------------------------------------------------
# CPX Research Publisher Credentials
# Get your App ID, Hash Key, and Postback Secret from:
# https://www.cpx-research.com/main/en/publisher-dashboard.php
# ------------------------------------------------------------------------------
CPX_APP_ID="YOUR_CPX_APP_ID"
CPX_HASH_KEY="YOUR_CPX_SECURE_HASH_KEY"
CPX_POSTBACK_SECRET="YOUR_CPX_POSTBACK_SECRET"
CPX_DEMO_MODE=true

# ------------------------------------------------------------------------------
# Tether (USDT) Payout Provider Configuration
# Supported networks: TRC20 (TRON), ERC20 (Ethereum/Polygon)
# ------------------------------------------------------------------------------
USDT_PAYOUT_PROVIDER="unconfigured"
USDT_DEFAULT_NETWORK="TRC20"
USDT_MIN_WITHDRAWAL_USD=25.00
USDT_MAX_WITHDRAWAL_USD=500.00
USDT_TRC20_FEE_USD=1.00
USDT_ERC20_FEE_USD=2.50
USDT_PAYOUT_API_KEY=""

# ------------------------------------------------------------------------------
# USDT Price / Peg Verification Provider
# ------------------------------------------------------------------------------
USDT_PRICE_FEED_PROVIDER="coingecko"
USDT_PRICE_CACHE_TTL_SECONDS=180

# ------------------------------------------------------------------------------
# Supabase Configuration (Backend & Client Auth / Database)
# Get your Project URL, Anon Key, and Service Role Key from:
# https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-admin-key"

# Client-side Supabase Environment Variables (Vite)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ------------------------------------------------------------------------------
# Google OAuth Configuration
# In Supabase Dashboard: Authentication -> Providers -> Google (Enable)
# Google Cloud Console Authorized Redirect URI:
# https://<your-project>.supabase.co/auth/v1/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"


